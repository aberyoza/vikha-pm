{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(?:.*\\.(?:php\\d?|asp|aspx|jsp|cgi|env|ini|bak|old|sql|swp|log|sh|yml|yaml)|\\.(?:env|git|svn|hg|aws|ssh|docker|vscode|idea|DS_Store)[^/]*(?:/.*)?|(?:wp-admin|wp-login|wp-content|wp-includes|wordpress|xmlrpc|phpmyadmin|pma|cgi-bin|vendor/phpunit|actuator|server-status|boaform|HNAP1)(?:/.*)?)",
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
