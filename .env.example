# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Both values are public (they ship to the browser); data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Shows sign-in and the cabinet. Keep it off in production until progress can be saved.
# NEXT_PUBLIC_AUTH_ENABLED=1
# Server only, a Resend key with sending access. Without it the site works but sends no letters about feedback.
# RESEND_API_KEY=
