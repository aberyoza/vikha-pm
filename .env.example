# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Both values are public (they ship to the browser); data is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Shows sign-in and the cabinet. Keep it off in production until progress can be saved.
# NEXT_PUBLIC_AUTH_ENABLED=1
# Server only, a Resend key with sending access. Without it the site works but sends no letters about feedback.
# RESEND_API_KEY=
# Closes modules 5-14 for anyone without approved access. Needs a new deployment after changing it.
# NEXT_PUBLIC_PAYWALL_ENABLED=1
# Server only, shown to a student with a waiting access request on /access. Not in the repo: the repo is public.
# PAYMENT_RECIPIENT="ФОП Прізвище Ім'я По батькові"
# PAYMENT_IBAN=UA00...
# PAYMENT_TAX_ID=
